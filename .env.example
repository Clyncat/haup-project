# สร้าง .env จริงด้วย: ./scripts/gen-env.sh

# Postgres
POSTGRES_USER=haup
POSTGRES_PASSWORD=
POSTGRES_DB=haup

# Garage secrets
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
GARAGE_CAPACITY=200G

# S3 bucket + key ให้ service ใช้
# Key ID ต้องเป็น "GK" + hex 24 ตัว, Secret เป็น hex 64 ตัว
S3_BUCKET=haup
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
