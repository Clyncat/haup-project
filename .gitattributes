# Normalize line endings: store LF in the repo, check out LF everywhere.
# Prevents "bash\r: bad interpreter" when files are edited on Windows.
* text=auto eol=lf

# --- Must always be LF (executed or parsed on Linux) ---
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.conf          text eol=lf
.env*           text eol=lf

# --- Windows-only scripts keep CRLF ---
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# --- Lockfiles: don't show diffs, avoid merge noise ---
package-lock.json  -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated
yarn.lock          -diff linguist-generated
bun.lock           -diff linguist-generated
bun.lockb          binary

# --- Binary files (no line-ending conversion, no text diff) ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4   binary
*.webm  binary
*.mp3   binary

# SVG is text but treat as generated for cleaner diffs/stats
*.svg   text eol=lf
